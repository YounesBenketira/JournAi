{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JournAi",
  "version": "0.1.8",
  "identifier": "com.younesbenketira.journai",
  "build": {
    "beforeDevCommand": "cd ../.. && pnpm --filter @journai/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../.. && pnpm --filter @journai/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JournAi",
        "width": 1000,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://journai.younesbenketira.com https://api.openai.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:journai.db"]
    }
  }
}
